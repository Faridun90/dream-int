{
  "name": "dream-int",
  "type": "commonjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.20.6 <=22.x"
  },
  "scripts": {
    "dev:next": "next dev",
    "dev:worker": "node workers/dreamWorker.js",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:next\" \"npm run dev:worker\"",
    "start:next": "next start",
    "start:worker": "node workers/dreamWorker.js",
    "start": "concurrently --kill-others-on-fail \"npm run start:next\" \"npm run start:worker\"",
    "build": "prisma generate && next build",
    "lint": "next lint",
    "prettier:format": "prettier --write \"**/*.{ts,tsx,js,md,mdx,css,yaml}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "worker": "node workers/dreamWorker.js"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.4",
    "@bull-board/express": "^6.7.4",
    "@hookform/resolvers": "^3.3.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-toast": "1.2.15",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.37.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "lucide-react": "0.542.0",
    "next": "^15.5.2",
    "next-auth": "^4.24.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.51.0",
    "redis": "^4.7.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.0",
    "husky": "^9.0.11",
    "ignore-loader": "^0.1.2",
    "lint-staged": "^15.2.2",
    "postcss": "8.5.6",
    "prettier": "3.2.5",
    "prisma": "^6.1.0",
    "tailwindcss": "4.1.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
